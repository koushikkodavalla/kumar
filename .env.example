# =======================================================
# Placement Management System - Environment Variables
# =======================================================

# MongoDB Atlas Connection String (REQUIRED for Vercel & local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/placementDB?retryWrites=true&w=majority

# JWT Authentication Secret (REQUIRED for production)
JWT_SECRET=super_secure_random_jwt_secret_key_here

# Default Administrator Credentials (created automatically on first launch if not exists)
ADMIN_NAME=Placement Administrator
ADMIN_EMAIL=admin@placementhub.com
ADMIN_PASSWORD=Admin@12345

# Local Development Settings
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional: Frontend API URL (leave blank when deployed unified on Vercel)
# VITE_API_URL=/api
